<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:models="clr-namespace:AcademicAssistant.Repositories.Models;assembly=AcademicAssistant.Repositories"
             xmlns:vm="clr-namespace:AcademicAssistant.Core.ViewModels;assembly=AcademicAssistant.Core"
             x:DataType="vm:HomeViewModel"
             x:Class="AcademicAssistant.Views.HomePage"
             Title="Home">

    <VerticalStackLayout>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="580"/>
                <RowDefinition Height= "48"/>
                <RowDefinition Height= "48"/>

            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <Image Grid.Row="0"
                   Grid.Column="0"
                   Source="owl.png"
                   HeightRequest="50"
                   WidthRequest="50"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"/>
            <Label
                Grid.Row="0"
                Grid.Column="0"
                Margin="100,0,100,0"
                Text="{Binding Student.Name}"
                FontSize="24"
                HorizontalOptions="Start"
                VerticalOptions="Center"/>
            <ImageButton
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,20,0"
                Source="{Binding NotificationIcon}"
                HeightRequest="48"
                WidthRequest="48"
                VerticalOptions="Center"
                HorizontalOptions="End"
                Clicked="NotificationButton_OnClicked"
                />

            <BoxView Grid.Row="1"
                     Grid.Column="0"
                     Color="{StaticResource aaLightAccent}"/>


                <CollectionView Grid.Row="2" Grid.Column="0"
                                x:Name="lvTerms"
                                SelectionMode="Single"
                                ItemsSource="{Binding Terms}" 
                                IsEnabled="True"
                                SelectedItem="{Binding SelectedTerm}"
                                EmptyView="Add a term to get started!"
                                SelectionChangedCommand="{Binding SelectionChangedCommand}" 
                                SelectionChangedCommandParameter="{Binding Path=SelectedItem, Source={RelativeSource Self}}"
                                >
                                
                    <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    
                                    
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource aaLightAccent}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="Transparent"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            

                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItemView>
                                        <HorizontalStackLayout BackgroundColor="Red">
                                            <ImageButton Source="delete.png" Margin="10,0" Command="{Binding DeleteTermCommand,
      Source={RelativeSource AncestorType={x:Type
        vm:HomeViewModel}}}"></ImageButton>
                                        </HorizontalStackLayout>
                                    </SwipeItemView>
                                    
                                </SwipeItems>
                            </SwipeView.RightItems>
                            
                            <Grid Padding="0, 24,0, 24">
                                
                                
                                
                                <!-- This context menu is for Windows, since swipe view doesn't work on Windows -->
                                <FlyoutBase.ContextFlyout >
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Delete" IconImageSource="delete.png" Command="{Binding DeleteTermCommand,
      Source={RelativeSource AncestorType={x:Type
        vm:HomeViewModel}}}"></MenuFlyoutItem>
                                    </MenuFlyout>
                                </FlyoutBase.ContextFlyout>
                                
                                
                                <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Image Grid.Column="0"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Source="term.png"
                                   VerticalOptions="Center"
                                    Margin="10,0,10,0"
                                    ></Image>
                            <Label Grid.Column="1"
                                   Grid.Row="0"
                                   x:DataType="models:Term"
                                   Text="{Binding Title}"
                                   Padding="10, 0"
                                   VerticalOptions="End"
                                   HorizontalOptions="Start"
                                   TextColor="{StaticResource aaDarkAccent}"
                                   FontSize="24"/>
                            <Label Grid.Column="1"
                                   Grid.Row="1"
                                   x:DataType="models:Term"
                                   Padding="10, 0, 0, 0"
                                   VerticalOptions="Start"
                                   HorizontalOptions="Start"
                                   FontSize="16"
                                   TextColor="{StaticResource aaFontAlt}">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0:MMM dd} - {1:MMM dd}">
                                        <Binding Path="StartDate" />
                                        <Binding Path="EndDate" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                            <Label Grid.Column="2"
                                   Grid.Row="0"
                                   Grid.RowSpan="2"
                                   x:DataType="models:Term"
                                   Text="{Binding CourseCount, StringFormat='{0} Courses'}"
                                   VerticalOptions="Center"
                                   HorizontalOptions="End"
                                   FontSize="24"
                                   Padding="0,0,10, 0"
                                   TextColor="{StaticResource aaFontMain}"/>
                            
                            
                        </Grid>
                        </SwipeView>
                        
                        
                        
                    </DataTemplate>
                        
                </CollectionView.ItemTemplate>
            </CollectionView>
            
            <SearchBar Margin="0,20,0,0" Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding SearchText, Mode=OneWayToSource}" SearchCommand="{Binding SearchCommand}" Placeholder="Search..." SearchCommandParameter="{Binding Text, Source={RelativeSource Self}}">
                <SearchBar.Behaviors>
                    <toolkit:EventToCommandBehavior
                        EventName="TextChanged"
                        Command="{Binding SearchCommand}" />
                </SearchBar.Behaviors>
            </SearchBar>
            <VerticalStackLayout Grid.Row="4" Grid.ColumnSpan="3">
                
                <HorizontalStackLayout VerticalOptions="End" HorizontalOptions="Center" Margin="0,5,0,0">
                    <Button  Text="Add Term" BackgroundColor="{StaticResource aaDarkAccent}" TextColor="{StaticResource aaBackground}" Margin="10, 10" VerticalOptions="Center" HorizontalOptions="Center" Command="{Binding AddTermCommand}"></Button>
                    <Button  IsVisible="{Binding TermSelected}" Text="View/Edit Term" BackgroundColor="{StaticResource aaDarkAccent}" TextColor="{StaticResource aaBackground}" Margin="10, 10" VerticalOptions="Center" HorizontalOptions="Center" Command="{Binding ViewSelectedTermCommand}"></Button>
                </HorizontalStackLayout>
                
            </VerticalStackLayout>

        </Grid>
        
        
    </VerticalStackLayout>

</ContentPage>