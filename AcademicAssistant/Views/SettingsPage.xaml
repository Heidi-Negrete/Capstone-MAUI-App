<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AcademicAssistant.Core.ViewModels;assembly=AcademicAssistant.Core"
             x:DataType="vm:SettingsViewModel"
             x:Class="AcademicAssistant.Views.SettingsPage"
             Title="Settings">
    <VerticalStackLayout>
        <Label Text="Settings"
               Style="{StaticResource Headline}"/>
        <Label
            Text="Change your cettings here!"
            VerticalOptions="Center"
            HorizontalOptions="Center"/>
        <HorizontalStackLayout Margin="0,24">
            <Label Text="Name"
                   Style="{StaticResource SubHeadline}"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   Margin="24,0,24,0"/>
            <Entry Placeholder="Student Name" Text="{Binding Student.Name}"></Entry>
        </HorizontalStackLayout>
        <Button Text="Save" Command="{Binding UpdateStudentCommand}"/>
    </VerticalStackLayout>
</ContentPage>