<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AcademicAssistant.Core.ViewModels;assembly=AcademicAssistant.Core"
             xmlns:models="clr-namespace:AcademicAssistant.Repositories.Models;assembly=AcademicAssistant.Repositories"
             xmlns:conv="clr-namespace:AcademicAssistant.Core.Converters;assembly=AcademicAssistant.Core"
             xmlns:tk="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="vm:TermDetailsViewModel"
             x:Class="AcademicAssistant.Views.TermDetailsPage"
             Title="Term Details">
    
    <ContentPage.Resources>
        <conv:AcademicStatusConverter x:Key="StatusConverter"></conv:AcademicStatusConverter>
    </ContentPage.Resources>
    
    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding AskUserToSaveChangesCommand}"/>   
    </Shell.BackButtonBehavior>
    
    <VerticalStackLayout>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="140"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="575"/>
                <RowDefinition Height= "48"/>

            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <Image Grid.Row="0"
                   Grid.Column="0"
                   Source="owl.png"
                   HeightRequest="50"
                   WidthRequest="50"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"/>
            <Entry
                Grid.Row="0"
                Grid.Column="0"
                x:Name="entryTitle"
                Margin="50,0,50,0"
                Text="{Binding Term.Title, FallbackValue='Term not found'}"
                FontSize="24"
                HorizontalOptions="Start"
                VerticalOptions="Center">
                <Entry.Behaviors>
                    <tk:TextValidationBehavior
                        MinimumLength="1"
                        Flags="ValidateOnValueChanged"
                        IsValid="{Binding ChangesValid}"
                        InvalidStyle="{StaticResource InvalidEntryStyle}"
                    />
                    <tk:EventToCommandBehavior
                        EventName="TextChanged"
                        Command="{Binding ConfirmTermDataChangedCommand}"
                        />
                </Entry.Behaviors>
            </Entry>
            <VerticalStackLayout 
                Grid.Row="0"
                Padding="0,0,0,10"
                Grid.Column="0"
                VerticalOptions="Center"
                HorizontalOptions="End">
                <HorizontalStackLayout>
                    <Label Text="Start Date: " FontSize="16" VerticalOptions="Center"></Label>
                    <DatePicker x:Name="dpStart" Date="{Binding Term.StartDate}">
                        <DatePicker.Behaviors>
                            <tk:EventToCommandBehavior
                                EventName="DateSelected"
                                Command="{Binding ConfirmTermDataChangedCommand}"
                                />
                        </DatePicker.Behaviors>
                    </DatePicker>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="End Date: " FontSize="16" VerticalOptions="Center"></Label>
                    <DatePicker x:Name="dpEnd" Date="{Binding Term.EndDate}">
                        <DatePicker.Behaviors>
                            <tk:EventToCommandBehavior
                                EventName="DateSelected"
                                Command="{Binding ConfirmTermDataChangedCommand}"
                            />
                        </DatePicker.Behaviors>
                    </DatePicker>
                </HorizontalStackLayout>
                <HorizontalStackLayout HorizontalOptions="Center">
                    <Label Text="Notifications: " FontSize="16" VerticalOptions="Center"></Label>
                    <Switch IsToggled="{Binding Term.NotificationEnabled}">
                        <Switch.Behaviors>
                            <tk:EventToCommandBehavior
                                EventName="Toggled"
                                Command="{Binding ConfirmTermDataChangedCommand}"/>
                        </Switch.Behaviors>
                    </Switch>
                </HorizontalStackLayout>
            </VerticalStackLayout>
            

            <BoxView Grid.Row="1"
                     Grid.Column="0"
                     Color="{StaticResource aaDarkAccent}"/>


                <CollectionView Grid.Row="2" Grid.Column="0"
                                x:Name="lvTerms"
                                Margin="0, 10, 0, 0"
                                SelectionMode="Single"
                                ItemsSource="{Binding Courses}" 
                                IsEnabled="True"
                                SelectedItem="{Binding SelectedCourse}"
                                EmptyView="Add a course to get started!"
                                SelectionChangedCommand="{Binding SelectionChangedCommand}" 
                                SelectionChangedCommandParameter="{Binding Path=SelectedItem, Source={RelativeSource Self}}"
                                >
                                
                    <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    
                                    
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource aaLightAccent}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="Transparent"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            

                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItemView>
                                        <HorizontalStackLayout BackgroundColor="Red">
                                            <ImageButton Source="delete.png" Margin="10,0" Command="{Binding DeleteCourseCommand,
      Source={RelativeSource AncestorType={x:Type
        vm:TermDetailsViewModel}}}"></ImageButton>
                                        </HorizontalStackLayout>
                                    </SwipeItemView>
                                    
                                </SwipeItems>
                            </SwipeView.RightItems>
                            
                            <Grid Padding="0, 24,0, 24">
                                
                                
                                
                                <!-- This context menu is for Windows, since swipe view doesn't work on Windows -->
                                <FlyoutBase.ContextFlyout >
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Delete" IconImageSource="delete.png" Command="{Binding DeleteCourseCommand, Source={RelativeSource AncestorType={x:Type
        vm:TermDetailsViewModel}}}"></MenuFlyoutItem>
                                    </MenuFlyout>
                                </FlyoutBase.ContextFlyout>
                                
                                
                                <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Image Grid.Column="0"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Source="course.png"
                                   VerticalOptions="Center"
                                    Margin="10,0,10,0"
                                    ></Image>
                            <Label Grid.Column="1"
                                   Grid.Row="0"
                                   x:DataType="models:Course"
                                   Text="{Binding Title}"
                                   Padding="10, 0"
                                   VerticalOptions="End"
                                   HorizontalOptions="Start"
                                   TextColor="{StaticResource aaDarkAccent}"
                                   FontSize="24"/>
                                <Label Grid.Column="2" Grid.Row="0" VerticalOptions="Center" x:DataType="models:Course"
                                       HorizontalOptions="End" Text="{Binding Status, Converter={StaticResource StatusConverter}}" />
                            <Label Grid.Column="2"
                                   Grid.Row="1"
                                   x:DataType="models:Course"
                                   VerticalOptions="Center"
                                   HorizontalOptions="End"
                                   FontSize="16"
                                   Padding="0,0,5, 0"
                                   TextColor="{StaticResource aaFontMain}">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0:MMM dd} - {1:MMM dd}">
                                        <Binding Path="StartDate" />
                                        <Binding Path="EndDate" />
                                    </MultiBinding>
                                </Label.Text>
                                </Label>
                        </Grid>
                        </SwipeView>
                        
                        
                        
                    </DataTemplate>
                        
                </CollectionView.ItemTemplate>
            </CollectionView>
            
            <VerticalStackLayout Grid.Row="3" Grid.ColumnSpan="3">
                <HorizontalStackLayout VerticalOptions="End" HorizontalOptions="Center">
                    <Button  IsVisible="{Binding TermDataChanged}" Text="Save" Style="{StaticResource ValidatedButton}" TextColor="{StaticResource aaBackground}" Margin="10, 10" VerticalOptions="Center" HorizontalOptions="Center" Command="{Binding SaveChangesCommand}" IsEnabled="{Binding ChangesValid}"/>
                    <Button  IsEnabled="{Binding NotReachedCourseLimit}" IsVisible="{Binding NotReachedCourseLimit}" Text="Add Course" BackgroundColor="{StaticResource aaDarkAccent}" TextColor="{StaticResource aaBackground}" Margin="10, 10" VerticalOptions="Center" HorizontalOptions="Center" Command="{Binding AddCourseCommand}"></Button>
                    <Button  IsVisible="{Binding CourseSelected}" Text="View/Edit Course" BackgroundColor="{StaticResource aaDarkAccent}" TextColor="{StaticResource aaBackground}" Margin="10, 10" VerticalOptions="Center" HorizontalOptions="Center" Command="{Binding ViewSelectedCourseCommand}"></Button>
                </HorizontalStackLayout>
                
            </VerticalStackLayout>
        </Grid>
    </VerticalStackLayout>
</ContentPage>