<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AcademicAssistant.Core.ViewModels;assembly=AcademicAssistant.Core"
             xmlns:models="clr-namespace:AcademicAssistant.Repositories.Models;assembly=AcademicAssistant.Repositories"
             xmlns:conv="clr-namespace:AcademicAssistant.Core.Converters;assembly=AcademicAssistant.Core"
             x:DataType="vm:CourseDetailsViewModel"
             x:Class="AcademicAssistant.Views.CourseDetailsPage"
             Title="Course Details">

    <ContentPage.Resources>
        <conv:AcademicStatusConverter x:Key="StatusConverter"></conv:AcademicStatusConverter>
    </ContentPage.Resources>
        
    <VerticalStackLayout>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="130"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="240"/>
                <RowDefinition Height="340"/>
                <RowDefinition Height= "48"/>

            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <Image Grid.Row="0"
                   Grid.Column="0"
                   Source="owl.png"
                   HeightRequest="50"
                   WidthRequest="50"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"/>
            <Entry
                Grid.Row="0"
                Grid.Column="0"
                Margin="50,0,50,0"
                Text="{Binding Course.Title, FallbackValue='Course not found'}"
                FontSize="24"
                HorizontalOptions="Start"
                VerticalOptions="Center"/>
            <VerticalStackLayout 
                Grid.Row="0"
                Padding="0,0,0,10"
                Grid.Column="0"
                VerticalOptions="Center"
                HorizontalOptions="End">
                <HorizontalStackLayout>
                    <Label Text="Start Date: " FontSize="16" VerticalOptions="Center"></Label>
                    <DatePicker Date="{Binding Course.StartDate}"></DatePicker>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="End Date: " FontSize="16" VerticalOptions="Center"></Label>
                    <DatePicker Date="{Binding Course.EndDate}"></DatePicker>
                </HorizontalStackLayout>
                <HorizontalStackLayout HorizontalOptions="Center">
                    <Label Text="Notifications: " FontSize="16" VerticalOptions="Center"></Label>
                    <Switch IsToggled="{Binding Course.NotificationEnabled}"></Switch>
                </HorizontalStackLayout>
            </VerticalStackLayout>
            

            <BoxView Grid.Row="1"
                     Grid.Column="0"
                     Color="{StaticResource aaDarkAccent}"/>


                <CollectionView Grid.Row="2" Grid.Column="0"
                                x:Name="lvTerms"
                                Margin="0, 10, 0, 0"
                                SelectionMode="Single"
                                ItemsSource="{Binding Assessments}" 
                                IsEnabled="True"
                                SelectedItem="{Binding SelectedAssessment}"
                                EmptyView="No Assessments Found."
                                SelectionChangedCommand="{Binding SelectionChangedCommand}" 
                                SelectionChangedCommandParameter="{Binding Path=SelectedItem, Source={RelativeSource Self}}"
                                >
                                
                    <CollectionView.ItemTemplate>
                    <DataTemplate>
                        
                            <Grid Padding="0, 24,0, 24">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                    
                                    
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{StaticResource aaLightAccent}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="Transparent"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                
                                <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Image Grid.Column="0"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Source="assessment.png"
                                   VerticalOptions="Center"
                                    Margin="10,0,10,0"
                                    ></Image>
                            <Label Grid.Column="1"
                                   Grid.Row="0"
                                   x:DataType="models:Assessment"
                                   Text="{Binding Title}"
                                   Padding="8, 0"
                                   VerticalOptions="End"
                                   HorizontalOptions="Start"
                                   TextColor="{StaticResource aaDarkAccent}"
                                   FontSize="24"/>
                            <Label Grid.Column="1"
                                   Grid.Row="1"
                                   x:DataType="models:Assessment"
                                   Padding="8, 0, 0, 0"
                                   Text="{Binding Type}"
                                   VerticalOptions="Start"
                                   HorizontalOptions="Start"
                                   FontSize="14"
                                   TextColor="{StaticResource aaFontAlt}"/>
                            <Label Grid.Column="2"
                                   Grid.Row="0"
                                   x:DataType="models:Assessment"
                                   Text="{Binding Status, Mode=OneWay, Converter={StaticResource StatusConverter}}"
                                   VerticalOptions="Center"
                                   HorizontalOptions="End"
                                   FontSize="20"
                                   Padding="0,0,5, 0"
                                   TextColor="{StaticResource aaFontMain}"/>
                                <Label Grid.Column="2"
                                       Grid.Row="1"
                                       VerticalOptions="Center"
                                       HorizontalOptions="End"
                                       FontSize="16"
                                       Padding="0,0,5, 0"
                                       TextColor="{StaticResource aaFontAlt}"
                                       x:DataType="models:Assessment">
                                    
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0:MMM dd} - {1:MMM dd}">
                                            <Binding Path="StartDate" />
                                            <Binding Path="EndDate" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            
                            
                        </Grid>
                        
                        
                        
                        
                    </DataTemplate>
                        
                </CollectionView.ItemTemplate>
            </CollectionView>
            
            
            
            <ScrollView Grid.Row="3" Grid.ColumnSpan="3">
                <VerticalStackLayout>
                    <BoxView HeightRequest="8" Margin="0,10" Color="{StaticResource aaLightAccent}"/>
                    <Label Text="Instructor: " FontSize="24" Margin="5,0,0,5"/>
                    <Frame HeightRequest="100" WidthRequest="350" CornerRadius="10" Padding="10">
                        <Label>
                        <Label.Text>
                            <MultiBinding StringFormat='{}{0}&#x0a;{1}&#x0a;{2}'>
                                <Binding Path="Course.InstructorName" />
                                <Binding Path="Course.InstructorEmail" />
                                <Binding Path="Course.InstructorPhone" />
                            </MultiBinding>
                        </Label.Text>
                            </Label>
                    </Frame>
                    
                    <Label Text="Notes:" Margin="5,5,5,5" FontSize="24"/>
                    <Frame HeightRequest="170" WidthRequest="350" CornerRadius="10" Padding="10">
                    
                        <Editor
                            Text="{Binding Course.Notes}"
                            FontSize="16"
                            Margin="10,10,10,10"/>
                    </Frame>
                    
                </VerticalStackLayout>
                
            </ScrollView>
            
            <VerticalStackLayout Grid.Row="4" Grid.ColumnSpan="3">
                
                <HorizontalStackLayout VerticalOptions="End" HorizontalOptions="Center">
                    <Button  IsVisible="{Binding AssessmentSelected}" Text="View/Edit Assessment" BackgroundColor="{StaticResource aaDarkAccent}" TextColor="{StaticResource aaBackground}" Margin="10, 10" VerticalOptions="Center" HorizontalOptions="Center" Command="{Binding ViewSelectedAssessmentCommand}"></Button>
                </HorizontalStackLayout>
                
                
                
            </VerticalStackLayout>

        </Grid>
        
        
    </VerticalStackLayout>
    
</ContentPage>