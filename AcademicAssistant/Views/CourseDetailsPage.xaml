<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AcademicAssistant.Core.ViewModels;assembly=AcademicAssistant.Core"
             xmlns:models="clr-namespace:AcademicAssistant.Repositories.Models;assembly=AcademicAssistant.Repositories"
             x:DataType="vm:CourseDetailsViewModel"
             x:Class="AcademicAssistant.Views.CourseDetailsPage"
             Title="Course Details">

    <VerticalStackLayout>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="650"/>
                <RowDefinition Height= "48"/>

            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <Image Grid.Row="0"
                   Grid.Column="0"
                   Source="owl.png"
                   HeightRequest="50"
                   WidthRequest="50"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"/>
            <Entry
                Grid.Row="0"
                Grid.Column="0"
                Margin="50,0,50,0"
                Text="{Binding Course.Title, FallbackValue='Course not found'}"
                FontSize="24"
                HorizontalOptions="Start"
                VerticalOptions="Center"/>
            <VerticalStackLayout 
                Grid.Row="0"
                Padding="0,0,0,10"
                Grid.Column="0"
                VerticalOptions="Center"
                HorizontalOptions="End">
                <HorizontalStackLayout>
                    <Label Text="Start Date: " FontSize="16" VerticalOptions="Center"></Label>
                    <DatePicker Date="{Binding Course.StartDate}"></DatePicker>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="End Date: " FontSize="16" VerticalOptions="Center"></Label>
                    <DatePicker Date="{Binding Course.EndDate}"></DatePicker>
                </HorizontalStackLayout>
            </VerticalStackLayout>
            

            <BoxView Grid.Row="1"
                     Grid.Column="0"
                     Color="{StaticResource aaDarkAccent}"/>


                <CollectionView Grid.Row="2" Grid.Column="0"
                                x:Name="lvTerms"
                                Margin="0, 10, 0, 0"
                                SelectionMode="Single"
                                ItemsSource="{Binding Assessments}" 
                                IsEnabled="True"
                                SelectedItem="{Binding SelectedAssessment}"
                                EmptyView="No Assessments Found."
                                SelectionChangedCommand="{Binding SelectionChangedCommand}" 
                                SelectionChangedCommandParameter="{Binding Path=SelectedItem, Source={RelativeSource Self}}"
                                >
                                
                    <CollectionView.ItemTemplate>
                    <DataTemplate>
                        
                            <Grid Padding="0, 24,0, 24">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                    
                                    
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{StaticResource aaLightAccent}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="Transparent"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                
                                <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Image Grid.Column="0"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Source="assessment.png"
                                   VerticalOptions="Center"
                                    Margin="10,0,10,0"
                                    ></Image>
                            <Label Grid.Column="1"
                                   Grid.Row="0"
                                   x:DataType="models:Assessment"
                                   Text="{Binding Title}"
                                   Padding="10, 0"
                                   VerticalOptions="End"
                                   HorizontalOptions="Start"
                                   TextColor="{StaticResource aaDarkAccent}"
                                   FontSize="24"/>
                                <!-- TO DO MAKE CONVERTER FOR type of Assessment (objective or performance) -->
                            <Label Grid.Column="1"
                                   Grid.Row="1"
                                   Padding="10, 0, 0, 0"
                                   Text="Performance Assessment"
                                   VerticalOptions="Start"
                                   HorizontalOptions="Start"
                                   FontSize="16"
                                   TextColor="{StaticResource aaFontAlt}"/>
                                <!-- TO DO MAKE CONVERTER for status of assessment -->
                                <!-- TO DO MAKE CONVERTER FOR Assessment due dates -->
                            <Label Grid.Column="2"
                                   Grid.Row="0"
                                   Text="Incomplete"
                                   VerticalOptions="Center"
                                   HorizontalOptions="End"
                                   FontSize="20"
                                   Padding="0,0,5, 0"
                                   TextColor="{StaticResource aaFontMain}"/>
                                <Label Grid.Column="2"
                                       Grid.Row="1"
                                       Text="Jan 1 - Jun 30"
                                       VerticalOptions="Center"
                                       HorizontalOptions="End"
                                       FontSize="16"
                                       Padding="0,0,5, 0"
                                       TextColor="{StaticResource aaFontAlt}"/>
                            
                            
                        </Grid>
                        
                        
                        
                        
                    </DataTemplate>
                        
                </CollectionView.ItemTemplate>
            </CollectionView>
            
            <VerticalStackLayout Grid.Row="3" Grid.ColumnSpan="3">
                <HorizontalStackLayout VerticalOptions="End" HorizontalOptions="Center">
                    <Button  IsVisible="{Binding AssessmentSelected}" Text="View/Edit Assessment" BackgroundColor="{StaticResource aaDarkAccent}" TextColor="{StaticResource aaBackground}" Margin="10, 10" VerticalOptions="Center" HorizontalOptions="Center" Command="{Binding ViewSelectedAssessmentCommand}"></Button>
                </HorizontalStackLayout>
                
            </VerticalStackLayout>

        </Grid>
        
        
    </VerticalStackLayout>
    
</ContentPage>