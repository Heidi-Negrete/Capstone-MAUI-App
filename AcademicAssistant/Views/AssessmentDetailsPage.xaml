<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AcademicAssistant.Core.ViewModels;assembly=AcademicAssistant.Core"
             xmlns:models="clr-namespace:AcademicAssistant.Repositories.Models;assembly=AcademicAssistant.Repositories"
             x:DataType="vm:AssessmentDetailsViewModel"
             x:Class="AcademicAssistant.Views.AssessmentDetailsPage"
             Title="Assessment Details">

    <VerticalStackLayout>
        
        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
            <Image
                   Source="owl.png"
                   HeightRequest="50"
                   WidthRequest="50"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"/>
            
            <VerticalStackLayout>
                <Entry
                
                    Margin="50,0,50,0"
                    Text="{Binding Assessment.Title, FallbackValue='Assessment not found'}"
                    FontSize="24"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"/>
                <Label FontSize="16" TextColor="{DynamicResource aaFontAlt}" Text="{Binding Assessment}" HorizontalOptions="Center"></Label>
            </VerticalStackLayout>
            
        </HorizontalStackLayout>
            
            
        <BoxView HeightRequest="8" Margin="0,10" Color="{StaticResource aaLightAccent}"/>
            
            <HorizontalStackLayout 
                Padding="0,0,0,10"
                VerticalOptions="Center"
                HorizontalOptions="Center">
                <HorizontalStackLayout HorizontalOptions="Center">
                    <Label Text="Start Date: " FontSize="16" VerticalOptions="Center"></Label>
                    <DatePicker Date="{Binding Assessment.StartDate}"></DatePicker>
                </HorizontalStackLayout>
                <HorizontalStackLayout HorizontalOptions="Center">
                    <Label Text="End Date: " FontSize="16" VerticalOptions="Center"></Label>
                    <DatePicker Date="{Binding Assessment.EndDate}"></DatePicker>
                </HorizontalStackLayout>
            </HorizontalStackLayout>
            
        <BoxView HeightRequest="8" Margin="0,10" Color="{StaticResource aaLightAccent}"/>
            <HorizontalStackLayout HorizontalOptions="Center">
                <Label Text="Status: " FontSize="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                <Picker HorizontalOptions="Center" FontSize="24" VerticalOptions="Center" ItemsSource="{Binding AssessmentStatusList}" Title="{Binding AssessmentStatus}"></Picker>
            </HorizontalStackLayout>
            
            
        <BoxView HeightRequest="8" Margin="0,10" Color="{StaticResource aaLightAccent}"/>
        
        <Label
               Text="About:"
               FontSize="24"
               Margin="10,10,10,10"/>
        <Frame HeightRequest="400" WidthRequest="350" CornerRadius="10" Padding="10">
            <Editor
                Text="{Binding About}"
                FontSize="16"
                Margin="10,10,10,10"/>
        </Frame>
            
        
    </VerticalStackLayout>
    
</ContentPage>